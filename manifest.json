{
  "schemaVersion": 1,
  "id": "jikotheguy.agentcron",
  "name": "AgentCron",
  "version": "0.1.0",
  "author": "jikotheguy",
  "license": "MIT",
  "description": "Scheduled agent jobs on systemd user timers, with run history and approval in the bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "AgentCron",
    "description": "Scheduled agent jobs: next run, last result, failures",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 60,
      "showWhenEmpty": true
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 10,
        "max": 3600,
        "step": 10,
        "defaultValue": 60
      },
      {
        "key": "showWhenEmpty",
        "type": "boolean",
        "label": "Show when no jobs exist",
        "defaultValue": true
      }
    ]
  }
}
